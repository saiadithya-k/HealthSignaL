# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthsignal
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432

# Application Settings
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/healthsignal
MIN_GROUP_SIZE=11
DEFAULT_FORECAST_HORIZON=7
RANDOM_SEED=42

# Frontend Settings
VITE_API_URL=/api/v1
