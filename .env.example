# Environment variables for HealthSignal

# System Configuration
PROJECT_NAME="HealthSignal"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthsignal

# Local DB URL for standalone backend running outside docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthsignal

# Privacy & Federation Defaults
MIN_GROUP_SIZE=11
DEFAULT_FORECAST_HORIZON=7
RANDOM_SEED=42
